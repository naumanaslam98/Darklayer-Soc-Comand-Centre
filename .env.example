# DarkLayer SOC Center — example configuration
# Copy to .env for manual setups. Never commit the real .env file.

SOC_NAME="DarkLayer SOC Center"
SOC_ADMIN_USER=admin
SOC_ADMIN_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
SOC_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./data/soc.db

# Machine collector authentication
SOC_AGENT_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_AGENT_KEY
SOC_URL=http://127.0.0.1:8000

# Local syslog listener. Keep localhost-only unless you intentionally
# configure a firewall / allow-list for remote collectors.
ENABLE_SYSLOG=true
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514

# Optional severe-alert email notifications
EMAIL_ALERT_MIN_SEVERITY=critical
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional macOS Unified Log predicate override.
# SOC_MACOS_LOG_PREDICATE=
